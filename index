    function loadClubToTeam(clubId) {
      const club = savedClubs.find(c => c.id === clubId);
      if (!club) return;

      const team = targetClubModalTeam;

      players = players.filter(p => p.team !== team);

      club.players.forEach((p, idx) => {
        players.push({
          id: `${team}_${Date.now()}_${idx}`,
          team: team,
          name: p.name,
          number: p.number,
          pos: p.pos,
          status: p.status,
          x: p.x,
          y: p.y,
          photo: p.photo
        });
      });

      if (team === 'A') {
        document.getElementById('teamA-name').value = club.name;
        document.getElementById('formation-A').value = club.formation;
      } else {
        document.getElementById('teamB-name').value = club.name;
        document.getElementById('formation-B').value = club.formation;
      }

      saveStateToLocalStorage();
      renderAll();
      closeModal('club-modal');
      showToast(`Clube "${club.name}" carregado no Time ${team}!`, "info");
    }

    function deleteClub(event, clubId) {
      if (event) event.stopPropagation();

      const clubIndex = savedClubs.findIndex(c => c.id === clubId);
      if (clubIndex === -1) return;

      const clubName = savedClubs[clubIndex].name;

      if (confirm(`Tem certeza de que deseja remover o clube "${clubName}"?`)) {
        savedClubs.splice(clubIndex, 1);
        saveStateToLocalStorage();
        renderClubList();
        showToast(`Clube "${clubName}" removido.`, "info");
      }
    }

