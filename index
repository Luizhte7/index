    function saveStateToLocalStorage() {
      const matchState = {
        players: players,
        teamAName: document.getElementById('teamA-name')?.value || 'Time A',
        teamBName: document.getElementById('teamB-name')?.value || 'Time B',
        formationA: document.getElementById('formation-A')?.value || '4-4-2',
        formationB: document.getElementById('formation-B')?.value || '4-3-3'
      };
      localStorage.setItem('tactical_board_match_state', JSON.stringify(matchState));
      localStorage.setItem('tactical_board_clubs', JSON.stringify(savedClubs));
      localStorage.setItem('tactical_board_library', JSON.stringify(globalPlayerLibrary));
    }

    function loadLocalStorageData() {
      try {
        const savedMatch = localStorage.getItem('tactical_board_match_state');
        if (savedMatch) {
          const data = JSON.parse(savedMatch);
          players = data.players || [];
          if (document.getElementById('teamA-name')) document.getElementById('teamA-name').value = data.teamAName || 'Time A';
          if (document.getElementById('teamB-name')) document.getElementById('teamB-name').value = data.teamBName || 'Time B';
          if (document.getElementById('formation-A')) document.getElementById('formation-A').value = data.formationA || '4-4-2';
          if (document.getElementById('formation-B')) document.getElementById('formation-B').value = data.formationB || '4-3-3';
        }
        const clubsData = localStorage.getItem('tactical_board_clubs');
        if (clubsData) savedClubs = JSON.parse(clubsData);

        const libData = localStorage.getItem('tactical_board_library');
        if (libData) globalPlayerLibrary = JSON.parse(libData);
      } catch (err) {
        console.error("Erro ao carregar dados salvos:", err);
      }
    }

    function renderAll() {
      renderPitch();
      renderBenchAndInjured();
      lucide.createIcons();
