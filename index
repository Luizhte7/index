    function renderPitch() {
      const dropZone = document.getElementById('pitch-drop-zone');
      dropZone.innerHTML = '';

      const pitchPlayers = players.filter(p => p.status === 'pitch');

      pitchPlayers.forEach(player => {
        const card = createPlayerTokenElement(player);
        card.style.position = 'absolute';
        card.style.left = `${player.x}%`;
        card.style.top = `${player.y}%`;
        card.style.transform = 'translate(-50%, -50%)';
        dropZone.appendChild(card);
      });
    }

    function renderBenchAndInjured() {
      const benchA = document.getElementById('benchA-container');
      const injuredA = document.getElementById('injuredA-container');
      const benchB = document.getElementById('benchB-container');
      const injuredB = document.getElementById('injuredB-container');

      benchA.innerHTML = ''; injuredA.innerHTML = '';
      benchB.innerHTML = ''; injuredB.innerHTML = '';

      players.forEach(player => {
        if (player.status === 'pitch') return;

        const card = createPlayerTokenElement(player);

        if (player.team === 'A') {
          if (player.status === 'bench') benchA.appendChild(card);
          else if (player.status === 'injured') injuredA.appendChild(card);
        } else {
          if (player.status === 'bench') benchB.appendChild(card);
          else if (player.status === 'injured') injuredB.appendChild(card);
        }
      });
    }

    function createPlayerTokenElement(player) {
      const card = document.createElement('div');
      card.className = `player-card flex flex-col items-center group select-none`;
      card.dataset.id = player.id;

      const isTeamA = player.team === 'A';
      const ringColor = isTeamA ? 'border-red-500 bg-red-950/80' : 'border-blue-500 bg-blue-950/80';
      const badgeBg = isTeamA ? 'bg-red-600' : 'bg-blue-600';

      card.innerHTML = `
        <div class="relative">
          <div class="player-avatar-ring w-9 h-9 md:w-11 md:h-11 rounded-full border-2 ${ringColor} overflow-hidden shadow-lg transition-all flex items-center justify-center">
            <img src="${player.photo}" class="w-full h-full object-cover pointer-events-none" onerror="this.src='${DEFAULT_AVATAR}'">
          </div>
          <span class="absolute -top-1 -right-1 ${badgeBg} text-white text-[9px] font-extrabold w-4 h-4 rounded-full flex items-center justify-center border border-slate-900 shadow">
            ${player.number}
          </span>
        </div>
        <div class="mt-0.5 bg-slate-900/90 backdrop-blur-xs px-1.5 py-0.5 rounded border border-slate-700/80 text-center max-w-[68px] md:max-w-[80px] truncate shadow">
          <p class="text-[9px] md:text-[10px] font-bold text-slate-100 truncate leading-tight">${player.name}</p>
          <p class="text-[8px] font-semibold text-emerald-400 leading-tight uppercase">${player.pos}</p>
        </div>
      `;

      setupDragAndDropEvents(card, player);
      return card;
    }

    function setupDragAndDropEvents(card, player) {
      let isDragging = false;
      let dragDistance = 0;
      let startX = 0, startY = 0;
      let tapTimer = null;
      let tapCount = 0;
      let currentHoveredTarget = null;

      const pitch = document.getElementById('tactical-pitch');

      const clearHoverHighlights = () => {
        document.querySelectorAll('.player-card.drop-target-hover').forEach(el => {
          el.classList.remove('drop-target-hover');
        });
        currentHoveredTarget = null;
      };

      const getPlayerTargetUnderPoint = (clientX, clientY) => {
        card.style.visibility = 'hidden';
        const elemBelow = document.elementFromPoint(clientX, clientY);
        card.style.visibility = 'visible';

        if (!elemBelow) return null;
        
        const targetCard = elemBelow.closest('.player-card');
        if (targetCard && targetCard.dataset.id !== player.id) {
          return targetCard;
        }
        return null;
      };

      const onStart = (e) => {
        isDragging = false;
        dragDistance = 0;

        const touch = e.touches ? e.touches[0] : e;
        startX = touch.clientX;
        startY = touch.clientY;

        if (e.type === 'touchstart') {
          document.addEventListener('touchmove', onMove, { passive: false });
          document.addEventListener('touchend', onEnd);
          document.addEventListener('touchcancel', onEnd);
        } else {
          document.addEventListener('mousemove', onMove);
          document.addEventListener('mouseup', onEnd);
        }
      };

      const onMove = (e) => {
        const touch = e.touches ? e.touches[0] : e;
        const deltaX = touch.clientX - startX;
        const deltaY = touch.clientY - startY;

        dragDistance = Math.sqrt(deltaX * deltaX + deltaY * deltaY);

        if (dragDistance > 6) {
          isDragging = true;
          if (e.cancelable) e.preventDefault();

          card.style.position = 'fixed';
          card.style.zIndex = '1000';
          card.style.left = `${touch.clientX}px`;
          card.style.top = `${touch.clientY}px`;
          card.style.transform = 'translate(-50%, -50%)';

          const targetCard = getPlayerTargetUnderPoint(touch.clientX, touch.clientY);
          if (targetCard !== currentHoveredTarget) {
            clearHoverHighlights();
            if (targetCard) {
              targetCard.classList.add('drop-target-hover');
              currentHoveredTarget = targetCard;
            }
          }
        }
      };

      const onEnd = (e) => {
        document.removeEventListener('mousemove', onMove);
        document.removeEventListener('touchmove', onMove);
        document.removeEventListener('mouseup', onEnd);
        document.removeEventListener('touchend', onEnd);
        document.removeEventListener('touchcancel', onEnd);

        if (isDragging) {
          const touch = e.changedTouches ? e.changedTouches[0] : e;
          const clientX = touch.clientX;
          const clientY = touch.clientY;

          const targetCard = getPlayerTargetUnderPoint(clientX, clientY);
          clearHoverHighlights();

          if (targetCard) {
            swapPlayers(player.id, targetCard.dataset.id);
          } else {
            const pitchRect = pitch.getBoundingClientRect();

            if (
              clientX >= pitchRect.left && clientX <= pitchRect.right &&
              clientY >= pitchRect.top && clientY <= pitchRect.bottom
            ) {
              const posX = ((clientX - pitchRect.left) / pitchRect.width) * 100;
              const posY = ((clientY - pitchRect.top) / pitchRect.height) * 100;

              player.status = 'pitch';
              player.x = Math.max(3, Math.min(97, posX));
              player.y = Math.max(3, Math.min(97, posY));
            } else {
              const targetZone = document.elementFromPoint(clientX, clientY);
              const benchZone = targetZone?.closest('.bench-zone');
              const injuredZone = targetZone?.closest('.injured-zone');

              if (benchZone) player.status = 'bench';
              else if (injuredZone) player.status = 'injured';
            }
          }
          saveStateToLocalStorage();
          renderAll();
        } else {
          handleCardTap(player);
        }
      };

      card.addEventListener('mousedown', onStart);
      card.addEventListener('touchstart', onStart, { passive: false });

      function handleCardTap(p) {
        tapCount++;
        if (tapCount === 1) {
          tapTimer = setTimeout(() => { tapCount = 0; }, 280);
        } else if (tapCount === 2) {
          clearTimeout(tapTimer);
          tapCount = 0;
          openEditModal(p.id);
        }
      }
    }

    function swapPlayers(id1, id2) {
      const p1 = players.find(p => p.id === id1);
      const p2 = players.find(p => p.id === id2);

      if (!p1 || !p2) return;

      const tempStatus = p1.status;
      p1.status = p2.status;
      p2.status = tempStatus;

      const tempX = p1.x;
      const tempY = p1.y;

      p1.x = p2.x;
      p1.y = p2.y;

      p2.x = tempX;
      p2.y = tempY;

      saveStateToLocalStorage();
    }

    function applyFormation(team) {
      const select = document.getElementById(`formation-${team}`);
      const formationKey = select.value;
      const coords = team === 'A' ? FORMATIONS[formationKey] : getTeamBPositions(formationKey);

      const teamPitchPlayers = players.filter(p => p.team === team && p.status === 'pitch');

      teamPitchPlayers.forEach((player, index) => {
        if (coords[index]) {
          player.x = coords[index].x;
          player.y = coords[index].y;
          player.pos = coords[index].pos;
        }
      });

      saveStateToLocalStorage();
      renderAll();
    }

