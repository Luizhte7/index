    }

    function importPlayerToField(libId, team) {
      const libPlayer = globalPlayerLibrary.find(p => p.id === libId);
      if (!libPlayer) return;

      const newPlayer = {
        id: `${team}_${Date.now()}`,
        team: team,
        name: libPlayer.name,
        number: libPlayer.number,
        pos: libPlayer.pos,
        status: 'bench',
        x: 0,
        y: 0,
        photo: libPlayer.photo
      };

      players.push(newPlayer);
      saveStateToLocalStorage();
      renderAll();
      closeModal('library-modal');
      showToast(`Atleta "${libPlayer.name}" adicionado aos reservas do Time ${team}.`, "info");
    }

    function deleteFromLibrary(libId) {
      globalPlayerLibrary = globalPlayerLibrary.filter(p => p.id !== libId);
      saveStateToLocalStorage();
      renderLibraryItems();
    }

    function openBackupModal() {
      document.getElementById('backup-modal').classList.remove('hidden');
    }

    function exportJSONBackup() {
      const data = {
        matchState: localStorage.getItem('tactical_board_match_state'),
        clubs: savedClubs,
        library: globalPlayerLibrary
      };

      const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
      const link = document.createElement('a');
      link.href = URL.createObjectURL(blob);
      link.download = `prancheta_tatica_backup_${new Date().toISOString().slice(0,10)}.json`;
      link.click();
    }

    function importJSONBackup(input) {
      if (input.files && input.files[0]) {
        const reader = new FileReader();
        reader.onload = function(e) {
          try {
            const data = JSON.parse(e.target.result);
            if (data.clubs) savedClubs = data.clubs;
            if (data.library) globalPlayerLibrary = data.library;
            if (data.matchState) localStorage.setItem('tactical_board_match_state', data.matchState);

            saveStateToLocalStorage();
            loadLocalStorageData();
            renderAll();
            closeModal('backup-modal');
            showToast("Backup importado com sucesso!", "success");
          } catch (err) {
            showToast("Arquivo JSON de backup inválido.", "error");
          }
        };
        reader.readAsText(input.files[0]);
      }
    }

    function openEditModal(playerId) {
      const player = players.find(p => p.id === playerId);
      if (!player) return;

      document.getElementById('edit-player-id').value = player.id;
      document.getElementById('edit-player-name').value = player.name;
      document.getElementById('edit-player-pos').value = player.pos;
      document.getElementById('edit-player-number').value = player.number;
      document.getElementById('edit-preview-img').src = player.photo;
      document.getElementById('edit-player-url').value = player.photo.startsWith('data:') ? '' : player.photo;
      document.getElementById('edit-player-file').value = '';

      document.getElementById('edit-modal').classList.remove('hidden');
    }

    function closeModal(modalId) {
      document.getElementById(modalId).classList.add('hidden');
    }

    function previewUrlImage(url) {
      if (url.trim()) document.getElementById('edit-preview-img').src = url;
    }

    function previewFileImage(input) {
      if (input.files && input.files[0]) {
        const reader = new FileReader();
        reader.onload = function (e) {
          document.getElementById('edit-preview-img').src = e.target.result;
        };
        reader.readAsDataURL(input.files[0]);
      }
    }

    function savePlayer(e) {
      e.preventDefault();
      const id = document.getElementById('edit-player-id').value;
      const player = players.find(p => p.id === id);

      if (player) {
        player.name = document.getElementById('edit-player-name').value;
        player.pos = document.getElementById('edit-player-pos').value;
        player.number = parseInt(document.getElementById('edit-player-number').value) || player.number;
        player.photo = document.getElementById('edit-preview-img').src;

        saveStateToLocalStorage();
        renderAll();
        closeModal('edit-modal');
      }
    }

    function resetPositions() {
      if (confirm("Deseja redefinir as posições dos times para o padrão?")) {
        initDefaultMatch();
        renderAll();
        showToast("Escalação resetada.", "info");
      }
    }

    function switchTab(team, tab) {
      const bench = document.getElementById(`bench${team}-container`);
      const injured = document.getElementById(`injured${team}-container`);
      const btnBench = document.getElementById(`tab${team}-bench`);
      const btnInjured = document.getElementById(`tab${team}-injured`);

      const activeColor = team === 'A' ? 'border-red-500 text-red-400' : 'border-blue-500 text-blue-400';

      if (tab === 'bench') {
        bench.classList.remove('hidden');
        injured.classList.add('hidden');
        btnBench.className = `flex-1 py-1 text-xs font-semibold border-b-2 ${activeColor}`;
        btnInjured.className = `flex-1 py-1 text-xs font-semibold text-slate-400 hover:text-slate-200`;
      } else {
        bench.classList.add('hidden');
        injured.classList.remove('hidden');
        btnInjured.className = `flex-1 py-1 text-xs font-semibold border-b-2 ${activeColor}`;
        btnBench.className = `flex-1 py-1 text-xs font-semibold text-slate-400 hover:text-slate-200`;
      }
    }

    function showToast(message, type = "info") {
      const container = document.getElementById('toast-container');
      const toast = document.createElement('div');
      
      const bgColors = {
        success: 'bg-emerald-600 text-white',
        error: 'bg-red-600 text-white',
        info: 'bg-slate-800 text-slate-100 border border-slate-700'
      };

      toast.className = `px-3 py-2 rounded-lg text-xs font-medium shadow-xl transition-all duration-300 transform translate-y-2 opacity-0 flex items-center gap-2 ${bgColors[type] || bgColors.info}`;
      toast.innerText = message;

      container.appendChild(toast);

      setTimeout(() => {
        toast.classList.remove('translate-y-2', 'opacity-0');
      }, 10);

      setTimeout(() => {
        toast.classList.add('opacity-0', 'translate-y-2');
        setTimeout(() => toast.remove(), 300);
      }, 3000);
    }

    function exportTactics() {
      const pitchElement = document.getElementById('tactical-pitch');
      html2canvas(pitchElement, {
        scale: 2,
        useCORS: true,
        backgroundColor: null
      }).then(canvas => {
        const link = document.createElement('a');
        link.download = 'escalacao-tatica.png';
        link.href = canvas.toDataURL('image/png');
        link.click();
      });
    }

    window.onload = initApp;
  </script>
</body>
</html>
