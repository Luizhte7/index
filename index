      saveStateToLocalStorage();
    }

    function buildClubDataObject(team, clubName) {
      const formation = document.getElementById(team === 'A' ? 'formation-A' : 'formation-B').value;
      const teamPlayers = players
        .filter(p => p.team === team)
        .map(p => ({
          name: p.name,
          number: p.number,
          pos: p.pos,
          status: p.status,
          x: p.x,
          y: p.y,
          photo: p.photo
        }));

      return {
        id: 'club_' + Date.now(),
        name: clubName,
        formation: formation,
        players: teamPlayers,
        savedAt: new Date().toLocaleDateString()
      };
    }

    function saveCurrentTeamAsClub(team) {
      const teamNameInput = document.getElementById(team === 'A' ? 'teamA-name' : 'teamB-name');
      const clubName = teamNameInput.value.trim();

      if (!clubName) {
        showToast("Por favor, digite um nome válido para o clube.", "error");
        return;
      }

      const existingIndex = savedClubs.findIndex(c => c.name.toLowerCase() === clubName.toLowerCase());

      if (existingIndex >= 0) {
        // Modal de opção de substituição
        const modalText = document.getElementById('overwrite-modal-text');
        modalText.innerText = `O clube "${savedClubs[existingIndex].name}" já está salvo. Deseja substituir os dados existentes ou criar um novo registro?`;

        document.getElementById('btn-overwrite-confirm').onclick = function() {
          const clubData = buildClubDataObject(team, savedClubs[existingIndex].name);
          clubData.id = savedClubs[existingIndex].id; // Mantém ID original
          savedClubs[existingIndex] = clubData;

          saveStateToLocalStorage();
          closeModal('overwrite-modal');
          showToast(`Clube "${clubData.name}" atualizado e substituído com sucesso!`, "success");
        };

        document.getElementById('btn-overwrite-new').onclick = function() {
          let count = 1;
          let newName = `${clubName} (${count})`;
          while (savedClubs.some(c => c.name.toLowerCase() === newName.toLowerCase())) {
            count++;
            newName = `${clubName} (${count})`;
          }

          const clubData = buildClubDataObject(team, newName);
          savedClubs.push(clubData);

          if (team === 'A') document.getElementById('teamA-name').value = newName;
          else document.getElementById('teamB-name').value = newName;

          saveStateToLocalStorage();
          closeModal('overwrite-modal');
          showToast(`Clube salvo como "${newName}"!`, "success");
        };

        document.getElementById('overwrite-modal').classList.remove('hidden');
      } else {
        const clubData = buildClubDataObject(team, clubName);
        savedClubs.push(clubData);
        saveStateToLocalStorage();
        showToast(`Clube "${clubName}" salvo com sucesso!`, "success");
      }
    }

