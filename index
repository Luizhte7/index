<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Prancheta Tática & Gestão de Clubes Pro</title>
  
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <!-- HTML2Canvas para Exportar a imagem do campo -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

  <style>
    body {
      font-family: 'Inter', sans-serif;
      touch-action: manipulation;
      user-select: none;
      -webkit-user-select: none;
    }

    /* Gramado do Campo */
    .pitch-bg {
      background-color: #2e7d32;
      background-image: repeating-linear-gradient(
        0deg,
        #2e7d32,
        #2e7d32 30px,
        #276b2b 30px,
        #276b2b 60px
      );
    }

    /* Tokens dos Jogadores */
    .player-card {
      touch-action: none;
      -webkit-touch-callout: none;
      cursor: grab;
      z-index: 10;
    }

    .player-card:active {
      cursor: grabbing;
    }

    /* Indicador Visual de Alvo durante o Arraste (Hover) */
    .player-card.drop-target-hover .player-avatar-ring {
      box-shadow: 0 0 0 4px #38bdf8, 0 0 20px #38bdf8 !important;
      transform: scale(1.15);
    }

    /* Prevent text highlight on mobile touch */
    * {
      -webkit-tap-highlight-color: transparent;
    }

    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #1f2937;
    }
    ::-webkit-scrollbar-thumb {
      background: #4b5563;
      border-radius: 3px;
    }
  </style>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen flex flex-col">

  <!-- Header / Barra Superior -->
  <header class="bg-slate-800 border-b border-slate-700 px-3 py-2 md:px-4 md:py-3 flex flex-wrap justify-between items-center gap-2">
    <div class="flex items-center space-x-2">
      <i data-lucide="shield" class="text-emerald-400 w-5 h-5 md:w-6 md:h-6"></i>
      <h1 class="font-bold text-base md:text-xl tracking-wide">Prancheta Tática Pro</h1>
    </div>

    <!-- Ações Globais: Biblioteca, Backup, Download -->
    <div class="flex items-center gap-1.5 md:gap-2 flex-wrap text-xs">
      <button onclick="openPlayerLibraryModal()" class="flex items-center gap-1 bg-indigo-600 hover:bg-indigo-500 active:scale-95 text-xs px-2.5 py-1.5 rounded-lg font-medium transition" title="Biblioteca Global de Jogadores">
        <i data-lucide="users" class="w-3.5 h-3.5"></i> <span class="hidden sm:inline">Biblioteca Jogadores</span>
      </button>
      <button onclick="openBackupModal()" class="flex items-center gap-1 bg-slate-700 hover:bg-slate-600 active:scale-95 text-xs px-2.5 py-1.5 rounded-lg font-medium transition" title="Backup em JSON">
        <i data-lucide="database" class="w-3.5 h-3.5"></i> <span class="hidden sm:inline">Backup JSON</span>
      </button>
      <button onclick="resetPositions()" class="flex items-center gap-1 bg-slate-700 hover:bg-slate-600 active:scale-95 text-xs px-2.5 py-1.5 rounded-lg transition" title="Redefinir Formações">
        <i data-lucide="rotate-ccw" class="w-3.5 h-3.5"></i> <span class="hidden sm:inline">Resetar</span>
      </button>
      <button onclick="exportTactics()" class="flex items-center gap-1 bg-emerald-600 hover:bg-emerald-500 active:scale-95 text-xs px-2.5 py-1.5 rounded-lg font-medium transition" title="Exportar para Imagem">
        <i data-lucide="download" class="w-3.5 h-3.5"></i> <span>Baixar Campo</span>
      </button>
    </div>
  </header>

  <!-- Conteúdo Principal -->
  <main class="flex-1 flex flex-col lg:flex-row overflow-y-auto lg:overflow-hidden relative">

    <!-- Painel Lateral Esquerdo: Controles & Elenco Time A -->
    <aside class="w-full lg:w-80 bg-slate-800/90 border-b lg:border-b-0 lg:border-r border-slate-700 p-3 flex flex-col gap-3 shrink-0">
      <!-- Gestão do Time A -->
      <div class="bg-slate-900/60 p-2.5 rounded-xl border border-red-500/30 space-y-2">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2 w-3/4">
            <input type="text" id="teamA-name" value="Time A (Vermelho)" onchange="updateTeamMeta('A')" class="bg-transparent font-bold text-red-400 border-b border-transparent hover:border-slate-600 focus:border-red-400 outline-none text-xs md:text-sm w-full">
          </div>
          <span class="w-3 h-3 rounded-full bg-red-500 inline-block"></span>
        </div>

        <!-- Seleção e Salvamento de Clube -->
        <div class="grid grid-cols-2 gap-1.5">
          <button onclick="openClubModal('A')" class="bg-slate-800 hover:bg-slate-700 active:scale-95 text-red-300 text-xs py-1 px-2 rounded border border-red-900/40 flex items-center justify-center gap-1">
            <i data-lucide="folder-open" class="w-3 h-3"></i> Carregar Clube
          </button>
          <button onclick="saveCurrentTeamAsClub('A')" class="bg-red-950/40 hover:bg-red-900/40 active:scale-95 text-red-300 text-xs py-1 px-2 rounded border border-red-800/50 flex items-center justify-center gap-1">
            <i data-lucide="save" class="w-3 h-3"></i> Salvar Clube
          </button>
        </div>

        <div>
          <label class="text-[10px] text-slate-400 block mb-1">Formação Tática</label>
          <select id="formation-A" onchange="applyFormation('A')" class="w-full bg-slate-800 border border-slate-700 rounded-md text-xs py-1 px-2 text-slate-200 focus:outline-none focus:border-red-400">
            <option value="4-4-2">4-4-2 Standard</option>
            <option value="4-3-3">4-3-3 Ofensivo</option>
            <option value="3-5-2">3-5-2 Equilibrado</option>
            <option value="4-2-3-1">4-2-3-1 Moderno</option>
            <option value="5-3-2">5-3-2 Defensivo</option>
          </select>
        </div>
      </div>

      <!-- Abas de Elenco Time A (Reservas/Lesionados) -->
      <div class="flex-1 flex flex-col min-h-[140px]">
        <div class="flex border-b border-slate-700 mb-2">
          <button onclick="switchTab('A', 'bench')" id="tabA-bench" class="flex-1 py-1 text-xs font-semibold border-b-2 border-red-500 text-red-400">Reservas</button>
          <button onclick="switchTab('A', 'injured')" id="tabA-injured" class="flex-1 py-1 text-xs font-semibold text-slate-400 hover:text-slate-200">Lesionados</button>
        </div>

        <div id="benchA-container" class="bench-zone flex-1 bg-slate-900/40 p-2 rounded-lg border border-dashed border-slate-700 min-h-[100px] flex flex-wrap gap-2 content-start overflow-y-auto"></div>
        <div id="injuredA-container" class="injured-zone hidden flex-1 bg-red-950/20 p-2 rounded-lg border border-dashed border-red-900/50 min-h-[100px] flex flex-wrap gap-2 content-start overflow-y-auto"></div>
      </div>
    </aside>

    <!-- Área Central: Campo Tático de Futebol -->
    <section class="flex-1 bg-slate-950 p-2 md:p-4 flex items-center justify-center overflow-auto min-h-[360px] md:min-h-[500px]">
      <div id="tactical-pitch" class="pitch-bg relative w-full max-w-[850px] aspect-[1.5/1] rounded-xl overflow-hidden shadow-2xl border-2 border-slate-700 flex flex-col justify-between p-2">
        <!-- Linhas Marcadoras do Campo (SVG) -->
        <svg class="absolute inset-0 w-full h-full pointer-events-none stroke-white/60 fill-none" stroke-width="2">
          <rect x="2%" y="3%" width="96%" height="94%" rx="4" />
          <line x1="50%" y1="3%" x2="50%" y2="97%" />
          <circle cx="50%" cy="50%" r="12%" />
          <circle cx="50%" cy="50%" r="0.5%" class="fill-white" />
          <rect x="2%" y="22%" width="16%" height="56%" />
          <rect x="2%" y="36%" width="6%" height="28%" />
          <path d="M 18% 42% A 12% 12% 0 0 1 18% 58%" />
          <rect x="82%" y="22%" width="16%" height="56%" />
          <rect x="92%" y="36%" width="6%" height="28%" />
          <path d="M 82% 42% A 12% 12% 0 0 0 82% 58%" />
        </svg>

        <div id="pitch-drop-zone" class="absolute inset-0 w-full h-full"></div>
      </div>
    </section>

    <!-- Painel Lateral Direito: Controles & Elenco Time B -->
    <aside class="w-full lg:w-80 bg-slate-800/90 border-t lg:border-t-0 lg:border-l border-slate-700 p-3 flex flex-col gap-3 shrink-0">
      <!-- Gestão do Time B -->
      <div class="bg-slate-900/60 p-2.5 rounded-xl border border-blue-500/30 space-y-2">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2 w-3/4">
            <input type="text" id="teamB-name" value="Time B (Azul)" onchange="updateTeamMeta('B')" class="bg-transparent font-bold text-blue-400 border-b border-transparent hover:border-slate-600 focus:border-blue-400 outline-none text-xs md:text-sm w-full">
          </div>
          <span class="w-3 h-3 rounded-full bg-blue-500 inline-block"></span>
        </div>

        <!-- Seleção e Salvamento de Clube -->
        <div class="grid grid-cols-2 gap-1.5">
          <button onclick="openClubModal('B')" class="bg-slate-800 hover:bg-slate-700 active:scale-95 text-blue-300 text-xs py-1 px-2 rounded border border-blue-900/40 flex items-center justify-center gap-1">
            <i data-lucide="folder-open" class="w-3 h-3"></i> Carregar Clube
          </button>
          <button onclick="saveCurrentTeamAsClub('B')" class="bg-blue-950/40 hover:bg-blue-900/40 active:scale-95 text-blue-300 text-xs py-1 px-2 rounded border border-blue-800/50 flex items-center justify-center gap-1">
            <i data-lucide="save" class="w-3 h-3"></i> Salvar Clube
          </button>
        </div>

        <div>
          <label class="text-[10px] text-slate-400 block mb-1">Formação Tática</label>
          <select id="formation-B" onchange="applyFormation('B')" class="w-full bg-slate-800 border border-slate-700 rounded-md text-xs py-1 px-2 text-slate-200 focus:outline-none focus:border-blue-400">
            <option value="4-4-2">4-4-2 Standard</option>
            <option value="4-3-3" selected>4-3-3 Ofensivo</option>
            <option value="3-5-2">3-5-2 Equilibrado</option>
            <option value="4-2-3-1">4-2-3-1 Moderno</option>
            <option value="5-3-2">5-3-2 Defensivo</option>
          </select>
        </div>
      </div>

      <!-- Abas de Elenco Time B (Reservas/Lesionados) -->
      <div class="flex-1 flex flex-col min-h-[140px]">
        <div class="flex border-b border-slate-700 mb-2">
          <button onclick="switchTab('B', 'bench')" id="tabB-bench" class="flex-1 py-1 text-xs font-semibold border-b-2 border-blue-500 text-blue-400">Reservas</button>
          <button onclick="switchTab('B', 'injured')" id="tabB-injured" class="flex-1 py-1 text-xs font-semibold text-slate-400 hover:text-slate-200">Lesionados</button>
        </div>

        <div id="benchB-container" class="bench-zone flex-1 bg-slate-900/40 p-2 rounded-lg border border-dashed border-slate-700 min-h-[100px] flex flex-wrap gap-2 content-start overflow-y-auto"></div>
        <div id="injuredB-container" class="injured-zone hidden flex-1 bg-red-950/20 p-2 rounded-lg border border-dashed border-red-900/50 min-h-[100px] flex flex-wrap gap-2 content-start overflow-y-auto"></div>
      </div>
    </aside>
  </main>

  <!-- MODAL DE CONFIRMAÇÃO DE SOBRESCRITA DE CLUBE -->
  <div id="overwrite-modal" class="fixed inset-0 bg-black/70 backdrop-blur-sm z-50 flex items-center justify-center hidden p-4">
    <div class="bg-slate-800 border border-amber-500/50 rounded-xl w-full max-w-sm overflow-hidden shadow-2xl p-4 space-y-4">
      <div class="flex items-center gap-2 text-amber-400 font-bold text-sm">
        <i data-lucide="alert-triangle" class="w-5 h-5"></i>
        <span>Clube Já Existente</span>
      </div>
      <p id="overwrite-modal-text" class="text-xs text-slate-300 leading-relaxed">
        Já existe um clube salvo com este nome. Deseja substituir a escalação antiga ou salvar com um novo nome?
      </p>
      <div class="flex flex-col gap-2 pt-2 border-t border-slate-700">
        <button id="btn-overwrite-confirm" class="w-full bg-amber-600 hover:bg-amber-500 text-white font-semibold text-xs py-2 rounded-lg transition">
          Sim, Substituir Clube
        </button>
        <button id="btn-overwrite-new" class="w-full bg-slate-700 hover:bg-slate-600 text-slate-200 text-xs py-2 rounded-lg transition">
          Não, Salvar com Novo Nome
        </button>
        <button onclick="closeModal('overwrite-modal')" class="w-full text-slate-400 hover:text-white text-xs py-1">
          Cancelar
        </button>
      </div>
    </div>
  </div>

  <!-- MODAL DE EDIÇÃO DE JOGADOR -->
  <div id="edit-modal" class="fixed inset-0 bg-black/70 backdrop-blur-sm z-50 flex items-center justify-center hidden p-4">
    <div class="bg-slate-800 border border-slate-700 rounded-xl w-full max-w-md overflow-hidden shadow-2xl">
      <div class="bg-slate-900/80 px-4 py-3 flex justify-between items-center border-b border-slate-700">
        <h3 class="font-bold text-slate-100 flex items-center gap-2 text-sm">
          <i data-lucide="user-cog" class="w-4 h-4 text-emerald-400"></i> Editar Atleta
        </h3>
        <button onclick="closeModal('edit-modal')" class="text-slate-400 hover:text-white p-1"><i data-lucide="x" class="w-5 h-5"></i></button>
      </div>

      <form id="edit-player-form" onsubmit="savePlayer(event)" class="p-4 space-y-3">
        <input type="hidden" id="edit-player-id">

        <div class="flex items-center gap-4">
          <div class="relative w-16 h-16 rounded-full overflow-hidden border-2 border-emerald-500 bg-slate-900 flex-shrink-0">
            <img id="edit-preview-img" src="" alt="Preview" class="w-full h-full object-cover">
          </div>
          <div class="text-xs text-slate-400">
            <p class="font-medium text-slate-200">Foto do Jogador</p>
            <p>Escolha um arquivo local ou cole um link direto da imagem.</p>
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1">Nome do Jogador</label>
          <input type="text" id="edit-player-name" required class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-1.5 text-sm text-slate-100 focus:outline-none focus:border-emerald-500">
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1">Posição</label>
            <select id="edit-player-pos" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-1.5 text-sm text-slate-100 focus:outline-none focus:border-emerald-500">
              <option value="GOL">Goleiro (GOL)</option>
              <option value="ZAG">Zagueiro (ZAG)</option>
              <option value="LE">Lateral Esq. (LE)</option>
              <option value="LD">Lateral Dir. (LD)</option>
              <option value="VOL">Volante (VOL)</option>
              <option value="MC">Meio Campo (MC)</option>
              <option value="MEI">Meia Atacante (MEI)</option>
              <option value="ATA">Atacante (ATA)</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1">Nº da Camisa</label>
            <input type="number" id="edit-player-number" min="1" max="99" required class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-1.5 text-sm text-slate-100 focus:outline-none focus:border-emerald-500">
          </div>
        </div>

        <div class="space-y-1">
          <label class="block text-xs font-semibold text-slate-300">Alterar Foto</label>
          <input type="url" id="edit-player-url" placeholder="URL da foto (ex: https://...)" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-1.5 text-xs text-slate-100 focus:outline-none focus:border-emerald-500" onchange="previewUrlImage(this.value)">
          <div class="text-center text-[10px] text-slate-500 font-bold">OU</div>
          <input type="file" id="edit-player-file" accept="image/*" class="block w-full text-xs text-slate-400 file:mr-3 file:py-1 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-slate-700 file:text-slate-200 hover:file:bg-slate-600 cursor-pointer" onchange="previewFileImage(this)">
        </div>

        <div class="pt-2 border-t border-slate-700 flex justify-between items-center">
          <button type="button" onclick="saveToGlobalLibraryFromModal()" class="text-xs bg-indigo-900/60 hover:bg-indigo-800 text-indigo-300 px-3 py-1.5 rounded-lg border border-indigo-700/50 flex items-center gap-1">
            <i data-lucide="bookmark" class="w-3.5 h-3.5"></i> Salvar na Biblioteca
          </button>
          <div class="flex gap-2">
            <button type="button" onclick="closeModal('edit-modal')" class="px-3 py-1.5 rounded-lg bg-slate-700 hover:bg-slate-600 text-xs text-slate-200">Cancelar</button>
            <button type="submit" class="px-3 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-xs text-white font-medium">Salvar</button>
          </div>
        </div>
      </form>
    </div>
  </div>

  <!-- MODAL BIBLIOTECA DE JOGADORES -->
  <div id="library-modal" class="fixed inset-0 bg-black/70 backdrop-blur-sm z-50 flex items-center justify-center hidden p-4">
    <div class="bg-slate-800 border border-slate-700 rounded-xl w-full max-w-2xl overflow-hidden shadow-2xl flex flex-col max-h-[85vh]">
      <div class="bg-slate-900/80 px-4 py-3 flex justify-between items-center border-b border-slate-700">
        <h3 class="font-bold text-slate-100 flex items-center gap-2 text-sm">
          <i data-lucide="users" class="w-4 h-4 text-indigo-400"></i> Biblioteca Global de Jogadores Salvos
        </h3>
        <button onclick="closeModal('library-modal')" class="text-slate-400 hover:text-white p-1"><i data-lucide="x" class="w-5 h-5"></i></button>
      </div>

      <div class="p-3 bg-slate-900/40 border-b border-slate-700 flex gap-2">
        <input type="text" id="library-search" oninput="renderLibraryItems()" placeholder="Buscar por nome, posição..." class="flex-1 bg-slate-900 border border-slate-700 rounded-lg px-3 py-1.5 text-xs text-slate-100 focus:outline-none focus:border-indigo-500">
      </div>

      <div id="library-list-container" class="p-4 overflow-y-auto flex-1 grid grid-cols-1 sm:grid-cols-2 gap-3 content-start">
        <!-- Jogadores Injetados pelo JS -->
      </div>
    </div>
  </div>

  <!-- MODAL GERENCIADOR DE CLUBES -->
  <div id="club-modal" class="fixed inset-0 bg-black/70 backdrop-blur-sm z-50 flex items-center justify-center hidden p-4">
    <div class="bg-slate-800 border border-slate-700 rounded-xl w-full max-w-lg overflow-hidden shadow-2xl flex flex-col max-h-[80vh]">
      <div class="bg-slate-900/80 px-4 py-3 flex justify-between items-center border-b border-slate-700">
        <h3 class="font-bold text-slate-100 flex items-center gap-2 text-sm">
          <i data-lucide="shield" class="w-4 h-4 text-amber-400"></i> Clubes Salvos
        </h3>
        <button onclick="closeModal('club-modal')" class="text-slate-400 hover:text-white p-1"><i data-lucide="x" class="w-5 h-5"></i></button>
      </div>

      <!-- Pesquisa de Clubes em Tempo Real -->
      <div class="p-3 bg-slate-900/40 border-b border-slate-700">
        <div class="relative">
          <i data-lucide="search" class="w-3.5 h-3.5 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"></i>
          <input type="text" id="club-search" oninput="renderClubList()" placeholder="Pesquisar clube pelo nome..." class="w-full bg-slate-900 border border-slate-700 rounded-lg pl-8 pr-3 py-1.5 text-xs text-slate-100 focus:outline-none focus:border-amber-500">
        </div>
      </div>

      <div id="club-list-container" class="p-4 overflow-y-auto flex-1 space-y-2">
        <!-- Lista de Clubes Injetada pelo JS -->
      </div>
    </div>
  </div>

  <!-- MODAL BACKUP / RESTORE JSON -->
  <div id="backup-modal" class="fixed inset-0 bg-black/70 backdrop-blur-sm z-50 flex items-center justify-center hidden p-4">
    <div class="bg-slate-800 border border-slate-700 rounded-xl w-full max-w-md overflow-hidden shadow-2xl p-4 space-y-4">
      <div class="flex justify-between items-center border-b border-slate-700 pb-2">
        <h3 class="font-bold text-slate-100 flex items-center gap-2 text-sm">
          <i data-lucide="database" class="w-4 h-4 text-emerald-400"></i> Backup e Restauração (JSON)
        </h3>
        <button onclick="closeModal('backup-modal')" class="text-slate-400 hover:text-white p-1"><i data-lucide="x" class="w-5 h-5"></i></button>
      </div>

      <div class="space-y-3">
        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1">Exportar Dados Salvos</label>
          <button onclick="exportJSONBackup()" class="w-full bg-emerald-700 hover:bg-emerald-600 text-white text-xs py-2 rounded-lg font-medium flex items-center justify-center gap-1.5">
            <i data-lucide="download" class="w-4 h-4"></i> Baixar Arquivo JSON de Backup
          </button>
        </div>

        <div class="border-t border-slate-700 pt-3">
          <label class="block text-xs font-semibold text-slate-300 mb-1">Importar Arquivo de Backup</label>
          <input type="file" id="backup-file-input" accept=".json" class="block w-full text-xs text-slate-400 file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-slate-700 file:text-slate-200 hover:file:bg-slate-600 cursor-pointer" onchange="importJSONBackup(this)">
        </div>
      </div>
    </div>
  </div>

  <!-- CONTAINER DE NOTIFICAÇÕES (TOAST) -->
  <div id="toast-container" class="fixed bottom-4 right-4 z-50 flex flex-col gap-2 pointer-events-none"></div>

  <!-- SCRIPT PRINCIPAL E DE PERSISTÊNCIA -->
  <script>
    const DEFAULT_AVATAR = "https://placehold.co/100x100/1e293b/38bdf8?text=PLAYER";

    const FORMATIONS = {
      '4-4-2': [
        { x: 6, y: 50, pos: 'GOL' },
        { x: 20, y: 18, pos: 'LE' }, { x: 18, y: 38, pos: 'ZAG' }, { x: 18, y: 62, pos: 'ZAG' }, { x: 20, y: 82, pos: 'LD' },
